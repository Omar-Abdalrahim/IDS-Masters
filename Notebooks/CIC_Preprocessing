","        print(f'Comparing full original vs actual sample: {attack}', flush=True)\n","        original_mask = (original_df['Attack'].isna() if pd.isna(attack)\n","                         else original_df['Attack'].eq(attack))\n","        sample_mask = (df['Attack'].isna() if pd.isna(attack)\n","                       else df['Attack'].eq(attack))\n","\n","        # Use every row in both datasets; process one feature at a time.\n","        for col in numeric_features:\n","            a = original_df.loc[original_mask, col].to_numpy(\n","                dtype=np.float64, na_value=np.nan\n","            )\n","            b = df.loc[sample_mask, col].to_numpy(\n","                dtype=np.float64, na_value=np.nan\n","            )\n","            finite_a = a[np.isfinite(a)]\n","            finite_b = b[np.isfinite(b)]\n","\n","            distance = (\n","                ks_2samp(finite_a, finite_b, method='asymp').statistic\n","                if len(finite_a) and len(finite_b) else np.nan\n","            )\n","            numeric_results.append({\n","                'Attack': attack,\n","                'feature': col,\n","                'Original rows': len(a),\n","                'Sample rows': len(b),\n","                'KS_D': distance,\n","                'Original missing (%)': 100 * np.isnan(a).mean(),\n","                'Sample missing (%)': 100 * np.isnan(b).mean(),\n","                'Original infinite (%)': 100 * np.isinf(a).mean(),\n","                'Sample infinite (%)': 100 * np.isinf(b).mean(),\n","            })\n","            del a, b, finite_a, finite_b\n","\n","        for col in categorical_features:\n","            original_frequencies = original_df.loc[\n","                original_mask, col\n","            ].value_counts(normalize=True, dropna=False)\n","            sample_frequencies = df.loc[\n","                sample_mask, col\n","            ].value_counts(normalize=True, dropna=False)\n","            frequencies = pd.concat([\n","                original_frequencies.rename('original'),\n","                sample_frequencies.rename('sample'),\n","            ], axis=1).fillna(0)\n","            tv_distance = (\n","                frequencies['original'] - frequencies['sample']\n","            ).abs().sum() / 2\n","            categorical_results.append({\n","                'Attack': attack,\n","                'feature': col,\n","                'TV_distance': tv_distance,\n","            })\n","            del original_frequencies, sample_frequencies, frequencies\n","\n","        del original_mask, sample_mask\n","\n","    numeric_distribution_report = pd.DataFrame(numeric_results, columns=[\n","        'Attack', 'feature', 'Original rows', 'Sample rows', 'KS_D',\n","        'Original missing (%)', 'Sample missing (%)',\n","        'Original infinite (%)', 'Sample infinite (%)',\n","    ]).sort_values('KS_D', ascending=False)\n","    categorical_distribution_report = pd.DataFrame(\n","        categorical_results, columns=['Attack', 'feature', 'TV_distance']\n","    ).sort_values('TV_distance', ascending=False)\n","\n","    print('Largest numerical distribution differences (KS distance):')\n","    display(numeric_distribution_report.head(30))\n","    if not numeric_distribution_report.empty:\n","        display(numeric_distribution_report.groupby('Attack', dropna=False)[\n","            'KS_D'\n","        ].agg(['median', 'max']))\n","    print('Categorical distribution differences (total variation distance):')\n","    display(categorical_distribution_report)\n","else:\n","    print('Within-class distribution comparisons disabled.')\n","\n","# Release the full original before encoding, splitting, and preprocessing.\n","# The sampled df and the small comparison reports remain available.\n","del original_df\n","gc.collect()\n","print('Sampling comparison finished; original data released from RAM.')"]},{"cell_type":"code","execution_count":12,"id":"61b5da8e","metadata":{"execution":{"iopub.ex